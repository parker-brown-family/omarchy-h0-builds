y -blur 0x24 -resize ${W}x${H}! -level 35%,85% $T/fog.png &&\nmagick -size ${W}x${H} gradient:black-black -fill white -draw \"rectangle 0,950 ${W},1480\" -blur 0x160 $T/fogmask.png &&\nmagick $T/base.png $T/hills1.png -composite $T/hills2.png -composite $T/tower.png -composite \\\n  $T/glow.png -compose screen -composite $T/streak.png -compose screen -composite \\\n  \\( $T/fog.png -fill '#5a6772' -colorize 60% $T/fogmask.png -compose copy_opacity -composite -channel A -evaluate multiply 0.55 +channel \\) -compose over -composite \\\n  $T/jettyr.png -compose over -composite $T/jetty.png -compose over -composite \\\n  -attenuate 0.25 +noise gaussian -quality 92 backgrounds/1-harbour-fog.jpg &&\nmagick identify backgrounds/1-harbour-fog.jpg && magick backgrounds/1-harbour-fog.jpg -resize 960x540 /tmp/hf-small.png && echo ok"}, "prev": "0f9af4c7dd3f78fe7e47849927731083634d999c61d57ab830982e3bb33f4339", "hash": "ba61470dbe9ecf59bcd14926c127484be6117812a851d73330e3fefaeaef24c9"}
