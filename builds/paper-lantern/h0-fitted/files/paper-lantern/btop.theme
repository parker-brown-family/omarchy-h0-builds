# Paper Lantern btop theme: ink on warm paper, red lantern highlights

# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#F4EDDF"

# Main text color
theme[main_fg]="#1C1915"

# Title color for boxes
theme[title]="#1C1915"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#B8322A"

# Background color of selected item in processes box
theme[selected_bg]="#E6D5BC"

# Foreground color of selected item in processes box
theme[selected_fg]="#B8322A"

# Color of inactive/disabled text
theme[inactive_fg]="#B3A792"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="#3D362E"

# Background color of the percentage meters
theme[meter_bg]="#E1D6C1"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#3D362E"

# CPU, Memory, Network, Proc box outline colors
theme[cpu_box]="#B8322A"
theme[mem_box]="#A87A12"
theme[net_box]="#6B4423"
theme[proc_box]="#3D362E"

# Box divider line and small boxes line color
theme[div_line]="#B3A792"

# Temperature graph color (cool ink -> amber -> lantern red)
theme[temp_start]="#5C7A2C"
theme[temp_mid]="#C25E1E"
theme[temp_end]="#B8322A"

# CPU graph colors (amber glow -> orange -> lantern red)
theme[cpu_start]="#C2921E"
theme[cpu_mid]="#C25E1E"
theme[cpu_end]="#B8322A"

# Mem/Disk free meter
theme[free_start]="#5C7A2C"
theme[free_mid]="#6F8F36"
theme[free_end]="#2D7C76"

# Mem/Disk cached meter
theme[cached_start]="#2F5A86"
theme[cached_mid]="#3E6FA0"
theme[cached_end]="#2D7C76"

# Mem/Disk available meter
theme[available_start]="#A87A12"
theme[available_mid]="#C25E1E"
theme[available_end]="#B8322A"

# Mem/Disk used meter
theme[used_start]="#C2921E"
theme[used_mid]="#C25E1E"
theme[used_end]="#B8322A"

# Download graph colors
theme[download_start]="#C2921E"
theme[download_mid]="#C25E1E"
theme[download_end]="#B8322A"

# Upload graph colors
theme[upload_start]="#857A6B"
theme[upload_mid]="#94396A"
theme[upload_end]="#B8322A"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#C2921E"
theme[process_mid]="#C25E1E"
theme[process_end]="#B8322A"
