{
  "schemaVersion": 1,
  "id": "parker.disk-free",
  "name": "Disk free",
  "version": "1.0.0",
  "author": "parker",
  "description": "Free space left on the root filesystem, red when under 10%",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Disk free",
    "description": "Free space left on the root filesystem",
    "category": "System",
    "allowMultiple": true,
    "defaultSection": "right",
    "defaults": {
      "path": "/",
      "interval": 60,
      "warnPercent": 10
    },
    "schema": [
      { "key": "path", "type": "string", "label": "Mount point" },
      { "key": "interval", "type": "number", "label": "Refresh interval (seconds)" },
      { "key": "warnPercent", "type": "number", "label": "Red below (% free)" }
    ]
  }
}
