{
  "schemaVersion": 1,
  "id": "parker.disk-free",
  "name": "Disk free",
  "version": "1.0.0",
  "author": "parker",
  "description": "Shows free space left on the main drive",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "DiskFree.qml"
  },
  "barWidget": {
    "displayName": "Disk free",
    "description": "Free space left on the main drive, red when running low",
    "category": "System",
    "allowMultiple": true,
    "defaultSection": "right",
    "defaults": {
      "path": "/",
      "intervalSec": 60,
      "warnPercent": 10
    },
    "schema": [
      {
        "key": "path",
        "type": "string",
        "label": "Mount point",
        "defaultValue": "/"
      },
      {
        "key": "intervalSec",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "min": 5,
        "max": 3600,
        "step": 5,
        "defaultValue": 60
      },
      {
        "key": "warnPercent",
        "type": "integer",
        "label": "Turn red below (% free)",
        "min": 1,
        "max": 99,
        "step": 1,
        "defaultValue": 10
      }
    ]
  }
}
