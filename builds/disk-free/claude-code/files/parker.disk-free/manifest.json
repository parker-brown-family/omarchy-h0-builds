{
  "schemaVersion": 1,
  "id": "parker.disk-free",
  "name": "Disk free",
  "version": "1.0.0",
  "author": "parker",
  "description": "Free space left on the main drive",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "DiskFree.qml"
  },
  "barWidget": {
    "displayName": "Disk free",
    "description": "Free space left on the main drive",
    "category": "System",
    "allowMultiple": true,
    "defaultSection": "right",
    "defaults": { "path": "/", "interval": 60, "lowPercent": 10 },
    "schema": [
      { "key": "path", "type": "string", "label": "Mount path" },
      { "key": "interval", "type": "number", "label": "Refresh interval (seconds)" },
      { "key": "lowPercent", "type": "number", "label": "Warn below (% free)" }
    ]
  }
}
